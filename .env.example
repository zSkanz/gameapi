# .env.example — copy to .env (git-ignored, chmod 600). Secrets/* are chmod-600 files.
# For local dev you can put plain values here; in production prefer the *_FILE variants
# (docker secrets) which are read BEFORE validation and win over the plain value.

# ---- infra / compose ----
REGISTRY=registry.example.com/skanz
API_IMAGE_TAG=1.0.0            # PINNED immutable git-sha tag, never :latest
API_REPLICAS=3                # ~= vCPU count
DOMAIN=api.yourgame.com
ACME_EMAIL=ops@yourgame.com
TZ=UTC

# ---- app runtime ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=1                  # Proxy ADDRESSES allowed to set X-Forwarded-For (IPs, CIDRs, or
                               # loopback / uniquelocal). The legacy 1 / true map to
                               # loopback,uniquelocal = Caddy on this host or the compose bridge.
                               # Stricter for a native VPS: TRUST_PROXY=loopback. 0/false = off.
SHUTDOWN_TIMEOUT_MS=20000
BODY_LIMIT_BYTES=16384
METRICS_ENABLED=true

# ---- auth ----
# Per-game keys (gk_<id>.<secret>) live in the api_keys table and are minted in the panel.
# API_KEYS below is the BOOTSTRAP key: one wildcard key that reaches every game. It exists so
# the games already in production keep working while they migrate one by one, and so you can
# still authenticate during a Postgres outage.
#
# Flip BOOTSTRAP_API_KEY_ENABLED to false once every game uses its own key — API_KEYS is then
# not required at all. Accepts true|1|yes; anything else is false, which fails CLOSED
# (per-game keys keep working, and the boot log says the bootstrap key is disabled).
BOOTSTRAP_API_KEY_ENABLED=true
# API_KEYS_FILE=/run/secrets/api_keys          # preferred in production (docker secret)
API_KEYS=dev_key_change_me_min_32_chars_00000000

# ---- redis ----
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
# REDIS_PASSWORD=
REDIS_KEY_PREFIX=gapi:v1:

# ---- postgres ----
DATABASE_URL=postgres://gameapi:gameapi@postgres:5432/gameapi
# PGPASSWORD_FILE=/run/secrets/postgres_password
# PGPASSWORD=
PG_POOL_MAX=10                # per Node process: API_REPLICAS x CLUSTER_WORKERS x this < max_connections (100)

# ---- behaviour ----
AUTO_PROVISION_GAMES=true         # dev convenience: auto-create the game row on first get-or-create
READ_CACHE_TTL_SECONDS=3          # short read cache (Redis) for GET/get + reads; 0 disables
CLUSTER_WORKERS=1                 # >1 forks N Node workers per container to use multiple cores

# ---- funnels ----
# Days of raw funnel events to keep. 30 = exactly what the panel's widest range shows; the sweep
# deletes at 31 so the oldest bucket of that view is never truncated. 0 = keep forever.
# This is the one table that grows with player-seconds rather than with purchases, so 0 really
# does mean unbounded — ~3 GB/year for a funnel with ~60k weekly entrants.
FUNNEL_RETENTION_DAYS=30

# ---- rate limits (sliding window per minute; per API key and per game) — Redis-backed ----
RATE_LIMIT_KEY_PER_MIN=6000
RATE_LIMIT_GAME_PER_MIN=12000

# ---- panel ----
# The owner account is created by `npm run panel:owner`, which GENERATES the password and
# prints it once. Deliberately not an env var: that would leave it in .env forever, race
# CLUSTER_WORKERS at boot, and silently ignore rotation.
# Locked out? `npm run panel:owner reset --username <name>` — the only way back in.
#
# REQUIRED in production, and must be https. Normalized to scheme://host[:port] at boot, so a
# trailing slash is tolerated. Without it there is no Origin check, and SameSite=Strict alone
# leaves the same-site-but-cross-origin gap open.
PANEL_ORIGIN=https://api.yourgame.com
PANEL_SESSION_IDLE_MINUTES=480      # 8h  — Redis key TTL, slid on each request
PANEL_SESSION_ABSOLUTE_HOURS=168    # 7d  — stored at login, never extended
PANEL_LOGIN_MAX_PER_IP=20           # per window, fixed (TTL never refreshed => no permanent lockout)
PANEL_LOGIN_MAX_PER_USER=50         # keep ABOVE per-IP, or one host can lock the owner out (see src/config/env.ts)
PANEL_LOGIN_WINDOW_SECONDS=900      # 15m

# ---- backups (compose pg-backup service) ----
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
RCLONE_REMOTE=b2:gameapi-backups
