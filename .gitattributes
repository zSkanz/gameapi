# Normalize line endings: store LF in the repo, check out LF everywhere.
# Keeps shell scripts (ops/*.sh) working inside Linux containers regardless of host OS.
* text=auto eol=lf

# Explicitly LF for scripts/config that Linux executes
*.sh   text eol=lf
*.lua  text eol=lf
*.conf text eol=lf

# Windows scripts must keep CRLF so cmd.exe/PowerShell run them cleanly
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary (never touch)
*.png binary
*.jpg binary
*.gz  binary
