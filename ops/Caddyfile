# Production reverse proxy. Caddy is the ONLY host-bound service; it terminates TLS and
# load-balances across the api replicas, routing only to /ready-healthy ones.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Never expose internal metrics publicly.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy {
		# Dynamic discovery of api replicas via Docker DNS (scales/rolls without editing this).
		dynamic a {
			name api
			port 3000
			refresh 5s
		}
		lb_policy least_conn
		health_uri /ready
		health_interval 5s
		lb_try_duration 5s
		fail_duration 10s

		# REPLACE the client's X-Forwarded-For rather than appending to it. Caddy appends by
		# default, so a forged header would survive as the leftmost entry — which is exactly
		# what the panel's per-IP login throttle keys on. Pairs with TRUST_PROXY=1.
		header_up X-Forwarded-For {remote_host}
	}

	# 16KB everywhere except config drafts, which carry whole JSON values (the API caps the whole
	# config at 1MB). Two exclusive matchers: request_body limits stack, so a general 16KB rule
	# would still cut a config draft short even with a larger rule next to it.
	@configDraft path_regexp ^/v1/(panel/)?games/[^/]+/config/draft$
	@notConfigDraft not path_regexp ^/v1/(panel/)?games/[^/]+/config/draft$
	request_body @notConfigDraft {
		max_size 16KB
	}
	request_body @configDraft {
		max_size 1100KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The panel's Origin check does not stop clickjacking: a framed victim's real clicks
		# carry the correct Origin. frame-ancestors is what actually denies the frame.
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		-Server
	}
}
