# Production reverse proxy. Caddy is the ONLY host-bound service; it terminates TLS and
# load-balances across the api replicas, routing only to /ready-healthy ones.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Never expose internal metrics publicly.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy {
		# Dynamic discovery of api replicas via Docker DNS (scales/rolls without editing this).
		dynamic a {
			name api
			port 3000
			refresh 5s
		}
		lb_policy least_conn
		health_uri /ready
		health_interval 5s
		lb_try_duration 5s
		fail_duration 10s
	}

	request_body {
		max_size 16KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
