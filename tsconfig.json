{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // src/panel-ui is a separate Vite/React project with its own tsconfig (DOM lib, ESNext
  // modules, jsx). Without this exclude the include glob above swallows its plain .ts files —
  // `document` becomes TS2584, `import.meta.env` becomes TS1343, and rootDir/outDir emit CJS
  // junk into dist/panel-ui/ that ships in the production image. Typechecked by the
  // second half of `npm run typecheck`.
  "exclude": ["node_modules", "dist", "**/__tests__/**", "test/**", "src/panel-ui"]
}
